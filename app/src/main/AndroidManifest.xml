<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/redhuellitas_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/redhuellitas_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.RedHuellitas">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".inicio"
            android:exported="false"
            android:label="@string/title_activity_inicio"
            android:theme="@style/Theme.RedHuellitas"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".registro"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Admin_login"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".registro_mascota"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".panel_admin"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".registro_org"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>